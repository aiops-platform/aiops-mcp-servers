# aiops-datasource-mcp-server 配置模板
# 复制为 .env 后按需修改：cp .env.example .env
#
# 本 server 暴露**领域型**只读工具（ES 日志 / Prometheus 指标 / K8s 状态）。
# 调用方传领域语义（如 metric=cpu_percent），不传 PromQL 表达式——
# 查询语义映射住在 server 侧，agent 无法写错查询。

# --- 运行环境 ---
# development | production（production 下强制要求 AUTH_TOKEN，防止服务裸奔）
ENVIRONMENT=development

# --- 服务 ---
# 8300：git=8000/8100、applog=8200/8101 之后的下一个
BIND_HOST=127.0.0.1
BIND_PORT=8300

# --- MCP 可选认证（Bearer） ---
# 留空 = 不启用认证（仅建议开发环境）；非空 = /mcp 要求 Authorization: Bearer <token>。
# 生成建议：python -c "import secrets;print(secrets.token_urlsafe(32))"
AUTH_TOKEN=

# --- Elasticsearch（日志） ---
DATASOURCE_ES_URL=http://localhost:19200
# 日志索引名；测试床为 app-logs（字段在 app.* 下：app.service / app.level / app.@timestamp）
DATASOURCE_ES_INDEX=app-logs

# --- Prometheus（指标） ---
DATASOURCE_PROM_URL=http://localhost:19090

# --- Kubernetes（Pod 状态） ---
# check_infra / describe_pod 的默认 namespace（调用时可覆盖）
DATASOURCE_K8S_NAMESPACE=order
# kubectl 二进制（空 = 走 PATH）
DATASOURCE_KUBECTL_BIN=kubectl
# kubeconfig 路径；空 = 用 kubectl 默认（~/.kube/config 或 in-cluster）
DATASOURCE_KUBECONFIG=

# --- CMDB / 仓库定位 ---
# 远端仓库组织（未配本地 root 时 locate_repo 返回 https://github.com/{org}/{repo}）
DATASOURCE_REPO_ORG=acme-aiops
# 本地仓库根目录（testbed 联调）。**非空**时 locate_repo 返回 file://{root}/{repo}
# 而非远端 URL；留空 = 走远端。注意这里**没有默认个人路径**，各环境在自己 .env 里配。
# 例：DATASOURCE_REPO_ROOT=/path/to/agentflow-testbed/services
DATASOURCE_REPO_ROOT=
# get_service_topology 默认跳数（调用方可显式覆盖）
DATASOURCE_TOPOLOGY_DEFAULT_HOPS=2
# CMDB 实体图谱文件（**CMDB 的唯一载体**）。留空 = 用包内自带的
# data/cmdb-entities.json（与 cwd 无关，随 wheel 分发）。
# 生产 / 多租户请指向挂载卷上可授权编辑的文件（将来的 CMDB 构建界面就编辑它）。
# 该文件缺失是**配置错误**——CMDB 工具会 fail-closed 报错，而不是返回空图。
# 例：DATASOURCE_CMDB_PATH=/data/cmdb/cmdb-entities.json
DATASOURCE_CMDB_PATH=
# 可选的事件覆盖文件（Incident / Change 节点，与主文件同 schema）。
# 留空 = 暂无事件数据——**这是合法状态，不是错误**（与上面刻意相反：主文件缺失是
# 配置问题，事件文件缺失只是还没数据）。配了路径却读不到才算配置错误。
# 例：DATASOURCE_INCIDENTS_PATH=/data/cmdb/incidents.json
DATASOURCE_INCIDENTS_PATH=

# --- 请求与配额 ---
# 单次上游请求超时（秒）
DATASOURCE_REQUEST_TIMEOUT_SEC=30.0
# 单次工具返回字节上限（超出流式截断并显式标注）
DATASOURCE_MAX_RESPONSE_BYTES=1048576
# 单次查询允许的最大时间跨度（小时）——防止全量扫描拖垮数据源
DATASOURCE_MAX_RANGE_HOURS=24
# query_metrics 默认采样步长（秒）
DATASOURCE_DEFAULT_STEP_SEC=30

# --- 日志 ---
LOG_LEVEL=INFO
