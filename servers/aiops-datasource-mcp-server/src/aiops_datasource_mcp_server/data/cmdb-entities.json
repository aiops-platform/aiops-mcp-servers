  "schema_version": "1.0.0",
  "metadata": {
    "source": "migrated from src/aiops_datasource_mcp_server/backends/cmdb.py (_SERVICES / _DEPENDS_ON), 2026-09-14; ontology revised per design-v5.7 §7.1, 2026-09-15; +3 business nodes (2 portfolio + 1 domain) added manually, 2026-09-15",
    "derived_rules": {
      "tier1_from_criticality": {
        "note": "tags:[\"tier1\"] 由 attributes.criticality == \"critical\" 派生。tier1 是二元业务断言，criticality 是四级技术属性，二者不是同一字段的两种写法——将来若「一级系统」改为包含 high，需要解耦。",
        "rule": "criticality == \"critical\"",
        "generated": true
      },
      "repo_now_an_edge": {
        "note": "仓库归属原为节点字段 refs.repo_ref，2026-09-15 起提升为 app_codebase 边（共 10 条）。派生索引 repo_by_app 仍从它构建，故 locate_repo 的对外契约不变。"
      },
      "portfolio_from_namespace_removed": {
        "note": "⚠️ 2026-09-15 删除了 6 个由 attributes.namespace 派生的 Portfolio 节点（order/payment/inventory/logistics/common/account）。原因是 namespace 是 **k8s 部署分组**，不是 **业务领域**——`common` 更是装着两个 owner 完全不同的服务。它们**不能改名沿用**：那会把部署分组的语义残留带进业务分类。业务层（enterprise/journey/portfolio/domain）现为**完全空置**，待录入真实业务域。"
      },
      "description_and_keywords": {
        "note": "节点的 description 与 keywords **全部为派生**，不是外部录入——description 由 tech + owner + tier + 调用图中的位置合成；keywords 由 name / namespace / owner / tech 机械派生，中文词是服务名与 owner 的忠实中译。⚠️ **它们不含任何真实用户用语**——真实工单里的说法必须另外补，否则业务语言的召回仍然落空。 ⚠️ 2026-09-15 修正：技术栈词（Java/Go/Spring Boot…）**已从 keywords 移除**——它们是**共享属性**（6 个服务都跑 Java），由 `tech` 字段匹配且证据弱一档。混进 keywords 会让「命中 tech」被当成识别性命中，进而把 6 个服务全标成 medium。",
        "generated": true
      }
    }
  },
