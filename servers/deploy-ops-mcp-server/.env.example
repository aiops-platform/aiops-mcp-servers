# deploy-ops-mcp-server 配置模板
# 复制为 .env 后按需修改：cp .env.example .env
#
# 本 server **只做一件事**：把某个 Deployment 滚到指定镜像，并如实回报结果。
# 唯一的写工具是 `rollout_deployment`。

# --- 运行环境 ---
# development | production（production 下强制要求 AUTH_TOKEN，防止"能滚线上的服务"裸奔）
ENVIRONMENT=development

# --- 服务 ---
# 8400：git=8000/8100、applog=8200/8101、datasource=8300 之后的下一个
BIND_HOST=127.0.0.1
BIND_PORT=8400

# --- MCP 可选认证（Bearer） ---
# 留空 = 不启用认证（仅建议开发环境）；非空 = /mcp 要求 Authorization: Bearer <token>。
AUTH_TOKEN=

# --- 集群 CLI（都走 PATH 查找；容器形态下给绝对路径）---
DEPLOY_OPS_KUBECTL_BIN=kubectl
DEPLOY_OPS_MINIKUBE_BIN=minikube
# docker CLI 只用于**启动自检**（本 server 不 build 镜像）
DEPLOY_OPS_DOCKER_BIN=docker
# kubeconfig 路径；空 = 用 kubectl 自身默认（~/.kube/config 或 in-cluster）
DEPLOY_OPS_KUBECONFIG=

# --- 部署目标表（本 server 自己持有；签名只收 service，不收 namespace）---
# JSON: {"<service>": {"namespace": ..., "deployment": ..., "container": ...}}
# ⚠️ 缺条 ⇒ 该服务的 rollout 调用 **fail-closed 报错**（不猜一个默认命名空间）
DEPLOY_OPS_TARGETS={"order-service": {"namespace": "order", "deployment": "order-service", "container": "order-service"}, "warranty-service": {"namespace": "order", "deployment": "warranty-service", "container": "warranty-service"}, "gateway-service": {"namespace": "order", "deployment": "gateway-service", "container": "gateway-service"}}

# --- 超时 ---
# ① kubectl rollout status --timeout=<N>s：kubectl 自己的等待预算（= 判定"这次没滚成功"的判据）
DEPLOY_OPS_ROLLOUT_TIMEOUT_SEC=300
# ② 子进程墙钟上限。**必须大于 ①**（否则会抢在 kubectl 超时前把它杀掉，报错分不清
#    「滚动慢」与「被我们砍了」）—— 违反时启动期直接报错，见 config.py 的 model_validator
DEPLOY_OPS_SUBPROCESS_TIMEOUT_SEC=360
# ③ minikube image load 的墙钟上限。量级完全不同：镜像（产物 35MB + 基础层 415MB）
#    要灌进节点 containerd，冷启动分钟级。**实测值待补**。
DEPLOY_OPS_IMAGE_LOAD_TIMEOUT_SEC=900
# 启动自检的探针超时（要短：起不来就赶紧报）
DEPLOY_OPS_PROBE_TIMEOUT_SEC=15

# --- 响应与日志 ---
DEPLOY_OPS_MAX_RESPONSE_BYTES=262144
LOG_LEVEL=INFO
