# applog-mcp-server 配置模板
# 复制为 .env 后按需修改：cp .env.example .env
#
# 工具定义（哪个 HTTP 接口 → 哪个 MCP tool）在 config/tools.yaml 声明，不在 .env 里。
# 新增一个日志查询接口 = 往 config/tools.yaml 追加一段 + 重启 server，无需改代码。

# --- 运行环境 ---
# development | production（production 下强制要求 AUTH_TOKEN，防止服务裸奔）
ENVIRONMENT=development

# --- 服务 ---
BIND_HOST=127.0.0.1
BIND_PORT=8101

# --- MCP 可选认证（Bearer） ---
# 留空 = 不启用认证（仅建议开发环境）；非空 = /mcp 要求 Authorization: Bearer <token>。
# 生成建议：python -c "import secrets;print(secrets.token_urlsafe(32))"
AUTH_TOKEN=TlbqXty5I7lCYPR8ATm2UQ34U4K6bv8nsPNLh8gStnU

# --- 上游日志接口默认值 ---
# tools.yaml 里 http.base_url 缺省时回落到这里的默认地址
APPLOG_DEFAULT_BASE_URL=http://localhost:8080
# 工具定义文件路径（相对 server 运行目录或绝对路径）
APPLOG_TOOLS_FILE=config/tools.yaml
# 单次上游请求超时（秒）
APPLOG_REQUEST_TIMEOUT_SEC=30.0
# 单次工具返回字节上限（超过则截断并标注）
APPLOG_MAX_RESPONSE_BYTES=1048576

# --- 日志 ---
LOG_LEVEL=INFO
