# git-mcp-server 配置模板
# 复制为 .env 后按需修改：cp .env.example .env

# --- 运行环境 ---
# development | production（production 强制要求 AUTH_TOKEN 与 GIT_ALLOWED_ROOTS）
ENVIRONMENT=development

# --- 服务 ---
BIND_HOST=127.0.0.1
BIND_PORT=8100

# --- 认证（MCP 原生 Bearer） ---
# 静态 Bearer Token；production 下为空则拒绝启动。生成建议：python -c "import secrets;print(secrets.token_urlsafe(32))"
AUTH_TOKEN=Bni9i5u1ijMMKj9BzawSctxXl_7G_ZIaOg-Ps5nj0BA

# --- Git 沙箱（路径白名单，逗号分隔；为空则拒绝所有仓库 fail-closed） ---
GIT_ALLOWED_ROOTS=/Users/h.a.hu/accenture/accenture_aiops_platform/acc-aiops-platform/sip-aiops-management

# --- 资源限制 ---
GIT_COMMAND_TIMEOUT_SEC=30.0
GIT_MAX_OUTPUT_BYTES=1048576

# --- Origin / Host 校验（防 DNS rebinding） ---
# 逗号分隔；ALLOWED_ORIGINS 为空则仅放行无 Origin 的请求（fail-closed）
ALLOWED_ORIGINS=
# 默认回环白名单；生产按需追加域名或内网 IP
ALLOWED_HOSTS=localhost,127.0.0.1,::1

# --- 限流（默认关闭） ---
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- 工具开关（逗号分隔；为空则全部启用） ---
# 可选值: get_repo_status,get_commit_log,get_commit_detail,list_branches,search_code,blame_file
TOOLS_ENABLED=

# --- 可观测性 ---
METRICS_ENABLED=true
LOG_LEVEL=INFO

# --- OpenTelemetry（可选，需安装 [otel] extra） ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
